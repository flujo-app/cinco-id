{
  "operator": "Paul",
  "defaultProject": "4d3d3d3",
  "maxWindows": 96,
  "voice": {
    "tts": { "engine": "voder", "python": "python", "voderPath": "C:/path/to/voder", "pitch": 104, "rate": 1.02, "voice": null, "windowsRate": 0 },
    "stt": {
      "engine": "whisper",
      "python": "C:/path/to/venv/Scripts/python.exe",
      "model": "large-v3",
      "device": "cuda",
      "computeType": "int8_float16",
      "hubCache": "C:/path/to/model/cache",
      "offline": true,
      "language": "en"
    }
  },
  "brain": {
    "enabled": true,
    "engine": "api",
    "baseUrl": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
