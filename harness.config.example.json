  },
  "media": { "python": "python" },
  "mcpServers": {
    "example": { "command": "npx", "args": ["-y", "some-mcp-server"], "disabled": true }
  },
  "whatsapp": { "enabled": false, "connectorDir": null, "brainTools": ["search_contacts", "get_contact_by_id"] },
  "events": {
    "whatsapp": { "secret": "whsec_<made by: npm run whatsapp:link>", "messages": "off", "declineTool": null }
  },
  "printouts": { "print": "pdf", "printer": "Microsoft Print to PDF" }
